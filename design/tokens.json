{
  "$description": "Supply Planner design tokens. Brand base from adaptyvbio.com CSS variables (shadcn naming); adjustments noted for contrast.",
  "font": {
    "sans": "Geist, ui-sans-serif, system-ui, sans-serif",
    "mono": "Geist Mono, ui-monospace, Menlo, monospace",
    "googleFonts": "https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap",
    "numeric": "tabular-nums on every numeric column and KPI",
    "scale": {
      "viewQuestion": {"size": 22, "weight": 500, "tracking": "-0.03em"},
      "kpiValue":     {"size": 40, "weight": 500, "tracking": "-0.04em"},
      "section":      {"size": 18, "weight": 500, "tracking": "-0.02em"},
      "body":         {"size": 16, "weight": 400},
      "secondary":    {"size": 14, "weight": 400},
      "eyebrow":      {"size": 13, "weight": 500, "tracking": "0.06em", "case": "uppercase"},
      "identifier":   {"family": "mono", "size": 15, "weight": 500}
    }
  },
  "color": {
    "foreground": "#142933",
    "foregroundSecondary": "#45525B",
    "muted": "#666666",
    "background": "#F7FBFE",
    "surface": "#FFFFFF",
    "band": "#EEF5FB",
    "border": "#DCE5EC",
    "borderStrong": "#C8D3DC",
    "divider": "#E9F2F7",
    "accentBg": "#E9F2F7",
    "primary": {"fill": "#36B7F6", "onFill": "#142933", "text": "#0A6FA6", "textHover": "#085A87",
                "note": "#36B7F6 is the site's --primary; white on it is 2.3:1, so fills carry ink text and links/lines use #0A6FA6 (5.5:1)."},
    "status": {
      "critical": {"icon": "#EF4444", "bg": "#FBE7E4", "text": "#8E1B12", "shape": "octagon"},
      "watch":    {"icon": "#FFBB00", "bg": "#FBF0D6", "text": "#6B4700", "shape": "triangle"},
      "ok":       {"icon": "#16A34A", "bg": "#E2F1E8", "text": "#1C5A3A", "shape": "circle-check"},
      "rule": "Never colour alone: always icon + label."
    },
    "site": {
      "LSN": {"color": "#8855FF", "marker": "square"},
      "LDN": {"color": "#0F8B8D", "marker": "circle"},
      "Group": {"color": "#142933", "marker": "diamond"}
    },
    "series": {"assay1": "#22394A", "assay2": "#6F8796", "assay3": "#B4C6D3", "assay4": "#D3DEE6", "competition": "hatched #22394A on white"},
    "leadTimeZone": {"fill": "#EAF1F7", "hatch": "#C8D3DC", "angle": 45}
  },
  "radius": {"card": 8, "control": 8, "badge": 13},
  "size": {"presentation": [1920, 1080], "admin": [1440, 1000], "panel": 680, "touchTarget": 44}
}
